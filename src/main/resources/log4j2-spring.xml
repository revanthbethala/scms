
<Configuration status="DEBUG">
	<Appenders>
		<!-- specifies how logs should be presented on console -->
		<Console name="LogToConsole" target="SYSTEM_OUT">
			<PatternLayout
				pattern="%d [%t] %-5level - %logger{36} 
				- %msg%n" />
			<!-- <PatternLayout pattern="%c{1} - %m%n" /> -->

		</Console>
		<File name="MyFileAppender" fileName="logs/app.log" level="warn">
			<PatternLayout
				pattern="%d{yyyy-MM-dd HH:mm:ss} %-5p %c{1} - %m%n" />
		</File>
	</Appenders>
	<Loggers>
		<Logger name="com.academy.scms" level="debug" additivity="false">
			<AppenderRef ref="LogToConsole" />
		</Logger>

		<Root level="warn">
			<AppenderRef ref="LogToConsole" />
			<AppenderRef ref="MyFileAppender" />
		</Root>
	</Loggers>
</Configuration>